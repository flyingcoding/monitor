<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="monitor-server"/>

    <springProfile name="dev">
        <property name="DEV_CONSOLE_PATTERN"
                  value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] (%X{reqId:-system}) %logger{36} - %msg%n"/>

        <appender name="DEV_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${DEV_CONSOLE_PATTERN}</pattern>
            </encoder>
        </appender>

        <appender name="DEV_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>log/monitor-server.log</file>
            <encoder>
                <pattern>${DEV_CONSOLE_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <FileNamePattern>log/%d{yyyy-MM-dd}-monitor-server-%i.log</FileNamePattern>
                <maxHistory>7</maxHistory>
                <maxFileSize>10MB</maxFileSize>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="DEV_CONSOLE"/>
            <appender-ref ref="DEV_FILE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- v2.0-tests：集成测试 profile（@ActiveProfiles("it")）必须有 appenders，
         否则 Spring Boot 不会 fallback 到默认 console appender，所有 application 日志
         都被丢弃 → CI 上看不到 AlertEvaluator / NotificationQueueListener /
         MailNotificationChannel / Webhook 等日志，调试无从下手。
         配置仅 CONSOLE，无文件输出（避免污染 CI 工作目录）。 -->
    <springProfile name="it">
        <appender name="IT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] (%X{reqId:-system}) %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="IT_CONSOLE"/>
        </root>
    </springProfile>
</configuration>
