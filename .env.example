# ========================================
# 运维监控系统 - 环境变量配置模板
# 复制此文件为 .env 并修改对应的值
# ========================================

# MySQL
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=monitor
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_PASSWORD=your_redis_password

# RabbitMQ
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=your_rabbitmq_password

# InfluxDB
INFLUX_USER=admin
INFLUX_PASSWORD=your_influx_password
INFLUX_ORG=flyingcoding
INFLUX_BUCKET=program

# JWT
JWT_KEY=your_jwt_secret_key

# SSH 密码加密（Base64编码的32字节密钥，示例值请在生产环境替换）
SSH_ENCRYPT_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# 邮件
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_auth_code
