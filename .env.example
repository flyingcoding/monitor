# ========================================
# 运维监控系统 - 环境变量配置模板
# 复制此文件为 .env 并修改对应的值
# ========================================

# MySQL
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=monitor
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_PASSWORD=your_redis_password

# RabbitMQ
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=your_rabbitmq_password

# InfluxDB
INFLUX_USER=admin
INFLUX_PASSWORD=your_influx_password
INFLUX_ORG=flyingcoding
INFLUX_BUCKET=program

# ========================================
# v2.0-beta：时序后端 VictoriaMetrics 可选切换
# ========================================
# influxdb（默认）或 victoria-metrics；切换前请先 `make up-vm` 启动 VM 容器
MONITOR_TSDB_PROVIDER=influxdb
# VM 服务地址，默认指向 docker-compose 内的 victoria-metrics 容器
VM_URL=http://victoria-metrics:8428
# VM 单节点数据卷宿主路径（默认 ./data/victoria-metrics）
VM_DATA_DIR=./data/victoria-metrics
# VM 数据保留期，默认 90d，按 VM 文档语法支持 60d / 12mo / 5y
VM_RETENTION=90d
# VM 暴露端口（默认 8428）
VM_PORT=8428

# vmctl 迁移：InfluxDB v2 不直连支持，vmctl 需要 v1 兼容凭证
# 步骤：在 InfluxDB 2.7 上执行 `influx v1 auth create --username monitor --password <pwd> --read-bucket <bucket-id>`
# 详见 docs/v2.0-beta-vm.md "vmctl 迁移：InfluxDB v2 → v1 兼容 workaround" 章节
INFLUX_V1_USERNAME=
INFLUX_V1_PASSWORD=
INFLUX_V1_URL=http://influxdb:8086

# JWT
JWT_KEY=your_jwt_secret_key

# API Token HMAC-SHA256 密钥（Base64 编码的 32 字节随机值，必须与 JWT_KEY 不同）
# v1.2 起 API Token 落库的哈希基于此密钥，旋转会让所有现有 Token 失效
API_TOKEN_HMAC_KEY=your_api_token_hmac_key

# OIDC/SSO 总开关（true 时启用 OAuth2 Client；具体 Provider 通过管理后台或 yaml 配置）
MONITOR_OIDC_ENABLED=false

# CORS 来源白名单（生产环境推荐逗号分隔精确 origin，例如 https://a.example.com,https://b.example.com）
# 生产环境建议填写精确 origin；本地开发如需允许所有来源可显式设为 *
CORS_ORIGIN=

# 密码复杂度策略：none = 不强制，basic = ≥8 字符且含字母与数字
# 生效场景：注册、修改密码、重置密码；老用户密码不强制升级
# 生产默认 basic；本地调试如需放宽可显式设为 none
PASSWORD_POLICY=basic

# SSH 密码加密（Base64编码的32字节密钥，必须与 JWT_KEY/API_TOKEN_HMAC_KEY 不同）
SSH_ENCRYPT_KEY=your_ssh_encrypt_key

# Client 注册令牌（启用 monitor-client profile 前请填写）
MONITOR_TOKEN=

# 邮件
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_auth_code
